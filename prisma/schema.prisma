generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum RsvpStatus {
  PENDING
  CONFIRMED
  DECLINED
}

enum CheckinKioskStatus {
  SHOW_QR
  WAITING_GUEST
  WAITING_CONFIRM
  SUCCESS
}

enum WhatsAppTemplateKind {
  INVITATION
  CONFIRMATION
  REMINDER
  THANK_YOU
  CUSTOM
}

model Event {
  id        String   @id @default(cuid())
  name      String
  startDate DateTime @db.Date
  endDate   DateTime @db.Date
  /// Lieu affiché sur l’invitation
  venue     String   @default("")
  timeRange String   @default("14h00 – 19h00")
  /// Horaires par jour : { "2026-08-27": { "start": "14:00", "end": "19:00" } }
  dayTimes  Json     @default("{}")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  guests    Guest[]
  templates EventWhatsAppTemplate[]

  @@index([startDate])
}

/// SID Twilio Content (HX…) par type de message, lié à un événement
model EventWhatsAppTemplate {
  id         String               @id @default(cuid())
  eventId    String
  event      Event                @relation(fields: [eventId], references: [id], onDelete: Cascade)
  kind       WhatsAppTemplateKind
  label      String
  contentSid String
  createdAt  DateTime             @default(now())
  updatedAt  DateTime             @updatedAt

  @@index([eventId])
}

model Guest {
  id                 String     @id @default(cuid())
  fullName           String?
  email              String?
  phone              String?
  token              String     @unique
  eventId            String?
  event              Event?     @relation(fields: [eventId], references: [id], onDelete: SetNull)
  /// Jours d'invitation — aligné sur Event.startDate…endDate si eventId renseigné
  eventDays          DateTime[] @db.Date
  /// Horaire affiché dans l'email et la page invitation — ex. « 14h00 – 19h00 »
  invitationTimeRange String    @default("14h00 – 19h00")
  rsvpStatus         RsvpStatus @default(PENDING)
  confirmedAt        DateTime?
  invitationSentAt   DateTime?
  invitationSentVia  String?
  /// Date de la première (et unique) création Carte Visa M-Pesa — empêche une 2e carte
  mpesaVisaCardIssuedAt DateTime?
  checkedInAt        DateTime?
  /// Créé via accès expérience kiosque (sans invitation événement)
  experienceOnly     Boolean    @default(false)
  createdAt          DateTime   @default(now())
  updatedAt          DateTime   @updatedAt
  accessOtps         InvitationAccessOtp[]
  mpesaVisaCard      MpesaVisaCard?
  checkinSessions    CheckinKioskSession[]

  @@index([eventId])
}

/// Session borne check-in self-service (écran QR + parcours mobile)
model CheckinKioskSession {
  id            String             @id @default(cuid())
  token         String             @unique
  status        CheckinKioskStatus @default(SHOW_QR)
  guestId       String?
  guest         Guest?             @relation(fields: [guestId], references: [id], onDelete: SetNull)
  displayName   String?
  scannedAt     DateTime?
  successEndsAt DateTime?
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt

  @@index([createdAt])
  @@index([status])
}

/// Carte Visa M-Pesa liée à un invité (expérience plateforme)
model MpesaVisaCard {
  id              String              @id @default(cuid())
  guestId         String              @unique
  guest           Guest               @relation(fields: [guestId], references: [id], onDelete: Cascade)
  cardLastFour    String
  cardMasked      String
  expiryMonth     Int
  expiryYear      Int
  bonusBalanceUsd Decimal             @default(0) @db.Decimal(10, 2)
  blocked         Boolean             @default(false)
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt
  purchases       CarrefourPurchase[]

  @@index([createdAt])
}

/// Achats Carrefour Market (bonus carte Visa)
model CarrefourPurchase {
  id          String        @id @default(cuid())
  cardId      String
  card        MpesaVisaCard @relation(fields: [cardId], references: [id], onDelete: Cascade)
  productId   String
  productName String
  priceUsd    Decimal       @db.Decimal(10, 2)
  createdAt   DateTime      @default(now())

  @@index([cardId])
  @@index([createdAt])
}

/// Code OTP pour accéder à l'invitation depuis la home (email ou WhatsApp)
model InvitationAccessOtp {
  id        String   @id @default(cuid())
  guestId   String
  guest     Guest    @relation(fields: [guestId], references: [id], onDelete: Cascade)
  channel   String
  address   String
  codeHash  String
  expiresAt DateTime
  attempts  Int      @default(0)
  createdAt DateTime @default(now())

  @@index([address, channel])
  @@index([guestId])
}
