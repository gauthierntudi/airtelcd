generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum RsvpStatus {
  PENDING
  CONFIRMED
  DECLINED
}

enum CheckinKioskStatus {
  SHOW_QR
  WAITING_GUEST
  WAITING_CONFIRM
  SUCCESS
}

model Guest {
  id                 String     @id @default(cuid())
  fullName           String?
  email              String?
  phone              String?
  token              String     @unique
  /// Jours d'invitation : 12, 13 et/ou 14 juin 2026 (1 à n)
  eventDays          DateTime[] @db.Date
  /// Horaire affiché dans l'email et la page invitation — ex. « 08h00 – 17h00 »
  invitationTimeRange String    @default("08h00 – 17h00")
  rsvpStatus         RsvpStatus @default(PENDING)
  confirmedAt        DateTime?
  invitationSentAt   DateTime?
  invitationSentVia  String?
  /// Date de la première (et unique) création Carte Visa M-Pesa — empêche une 2e carte
  mpesaVisaCardIssuedAt DateTime?
  checkedInAt        DateTime?
  createdAt          DateTime   @default(now())
  updatedAt          DateTime   @updatedAt
  accessOtps         InvitationAccessOtp[]
  mpesaVisaCard      MpesaVisaCard?
  checkinSessions    CheckinKioskSession[]
}

/// Session borne check-in self-service (écran QR + parcours mobile)
model CheckinKioskSession {
  id            String             @id @default(cuid())
  token         String             @unique
  status        CheckinKioskStatus @default(SHOW_QR)
  guestId       String?
  guest         Guest?             @relation(fields: [guestId], references: [id], onDelete: SetNull)
  displayName   String?
  scannedAt     DateTime?
  successEndsAt DateTime?
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt

  @@index([createdAt])
  @@index([status])
}

/// Carte Visa M-Pesa liée à un invité (expérience plateforme)
model MpesaVisaCard {
  id              String              @id @default(cuid())
  guestId         String              @unique
  guest           Guest               @relation(fields: [guestId], references: [id], onDelete: Cascade)
  cardLastFour    String
  cardMasked      String
  expiryMonth     Int
  expiryYear      Int
  bonusBalanceUsd Decimal             @default(0) @db.Decimal(10, 2)
  blocked         Boolean             @default(false)
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt
  purchases       CarrefourPurchase[]

  @@index([createdAt])
}

/// Achats Carrefour Market (bonus carte Visa)
model CarrefourPurchase {
  id          String        @id @default(cuid())
  cardId      String
  card        MpesaVisaCard @relation(fields: [cardId], references: [id], onDelete: Cascade)
  productId   String
  productName String
  priceUsd    Decimal       @db.Decimal(10, 2)
  createdAt   DateTime      @default(now())

  @@index([cardId])
  @@index([createdAt])
}

/// Code OTP pour accéder à l'invitation depuis la home (email ou WhatsApp)
model InvitationAccessOtp {
  id        String   @id @default(cuid())
  guestId   String
  guest     Guest    @relation(fields: [guestId], references: [id], onDelete: Cascade)
  channel   String
  address   String
  codeHash  String
  expiresAt DateTime
  attempts  Int      @default(0)
  createdAt DateTime @default(now())

  @@index([address, channel])
  @@index([guestId])
}
