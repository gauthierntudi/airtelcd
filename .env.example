# Neon — https://console.neon.tech
# Utiliser l'hôte *-pooler* pour DATABASE_URL. Ne pas ajouter channel_binding=require (P1001 macOS).
# connection_limit bas en local si plusieurs `npm run dev` tournent en parallèle.
DATABASE_URL="postgresql://USER:PASSWORD@ep-xxx-pooler.region.aws.neon.tech/neondb?sslmode=require&connect_timeout=60&pool_timeout=20&connection_limit=5"
DIRECT_URL="postgresql://USER:PASSWORD@ep-xxx.region.aws.neon.tech/neondb?sslmode=require&connect_timeout=60"

ADMIN_SECRET="change-me-in-production"
# Optionnel — secret dédié aux codes OTP invitation (sinon ADMIN_SECRET)
# INVITATION_OTP_SECRET=""
# Durée de la session après OTP validé (jours, défaut 30)
# INVITATION_SESSION_DAYS="30"
# URL publique des liens d'invitation (email, QR, admin)
# Local : http://localhost:3001  |  Prod : https://vodacomprivilege.com
NEXT_PUBLIC_APP_URL="http://localhost:3001"
# Optionnel — IP précise si le wildcard 192.168.*.* ne suffit pas (next.config.ts)
# ALLOWED_DEV_ORIGIN="192.168.1.67"

# Brevo (email) — https://app.brevo.com → SMTP & API → clé API
# Expéditeur : adresse vérifiée dans Brevo (Senders)
BREVO_API_KEY=""
BREVO_SENDER_EMAIL="noreply@votredomaine.com"
BREVO_SENDER_NAME="Vodacom Privilege Golf"

# Twilio WhatsApp — envoi invitations (compte / credentials dédiés)
TWILIO_WHATSAPP_ACCOUNT_SID=""
TWILIO_WHATSAPP_AUTH_TOKEN=""
TWILIO_WHATSAPP_FROM="whatsapp:+14155238886"
# Template WhatsApp validé (Content SID) — {{1}} nom invité, {{2}} token invitation
TWILIO_WHATSAPP_CONTENT_INVITE_SID=""

# Twilio SMS — codes OTP accès invitation (compte / credentials séparés)
TWILIO_SMS_ACCOUNT_SID=""
TWILIO_SMS_AUTH_TOKEN=""
# Expéditeur SMS Twilio : numéro E.164 (+243…) ou Sender ID (ex. GOLF2026, selon compte Twilio)
TWILIO_SMS_FROM=""

# Déprécié — préférer TWILIO_WHATSAPP_ACCOUNT_SID / TWILIO_WHATSAPP_AUTH_TOKEN
# TWILIO_ACCOUNT_SID=""
# TWILIO_AUTH_TOKEN=""
